DB_HOST=localhost
DB_PORT=3306
DB_NAME=abnormal_alarm
DB_USER=your_user
DB_PASSWORD=your_password

AI_SERVER_URL=http://localhost:8000
BACKEND_SERVER_URL=http://localhost:8080

JWT_SECRET=your_jwt_secret

# 영상 저장 모드: local(기본, uploads/ 저장) / s3(운영, EC2 Role 필요)
# S3 자격증명 키는 넣지 않는다 — EC2 인스턴스 프로파일 Role로 자동 인증
APP_STORAGE_MODE=local
S3_BUCKET=project10-86-virg-apap-media
AWS_REGION=us-east-1
