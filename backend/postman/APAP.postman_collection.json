{
  "info": {
    "_postman_id": "9a3596dd-4f9d-4a63-9f2c-apap-backend",
    "name": "APAP",
    "description": "APAP 백엔드 API 테스트 컬렉션입니다. 왼쪽 메뉴에서 위에서 아래 순서대로 실행하면 전체 흐름을 확인할 수 있습니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "googleIdToken",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "videoSourceId",
      "value": "1"
    },
    {
      "key": "jobId",
      "value": "1"
    },
    {
      "key": "alertId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "서버 상태",
      "item": [
        {
          "name": "서버 상태 확인",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "구글 로그인",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.user && json.data.user.id) {",
                  "  pm.collectionVariables.set('userId', json.data.user.id);",
                  "}",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "google"
              ]
            }
          },
          "description": "프론트엔드(Google Identity Services)가 발급한 구글 OIDC ID 토큰으로 로그인/회원가입합니다. 환경 변수 googleIdToken에 실제 ID 토큰을 넣어 실행하세요. 응답의 user.id가 userId, accessToken이 accessToken 변수로 자동 저장됩니다."
        },
        {
          "name": "내 정보 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "me" ]
            }
          }
        },
        {
          "name": "로그아웃",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "auth", "logout" ]
            }
          }
        }
      ]
    },
    {
      "name": "Cameras",
      "item": [
        {
          "name": "카메라/영상 등록",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('videoSourceId', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"UPLOAD\",\n  \"name\": \"sample-video\",\n  \"sourceUrl\": \"uploads/sample.mp4\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/videos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "videos"
              ]
            }
          }
        },
        {
          "name": "카메라/영상 목록 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/videos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "videos"
              ]
            }
          }
        },
        {
          "name": "영상 파일 업로드",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/videos/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "videos",
                "upload"
              ]
            }
          },
          "description": "Postman Body > form-data에서 file 필드에 로컬 영상 파일을 선택합니다."
        },
        {
          "name": "카메라/영상 상세 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/videos/{{videoSourceId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "videos", "{{videoSourceId}}" ]
            }
          }
        },
        {
          "name": "카메라/영상 수정",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"CCTV\",\n  \"name\": \"수정된 이름\",\n  \"sourceUrl\": \"rtsp://example/stream\",\n  \"status\": \"READY\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/videos/{{videoSourceId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "videos", "{{videoSourceId}}" ]
            }
          }
        },
        {
          "name": "카메라/영상 삭제(soft delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/videos/{{videoSourceId}}",
              "host": [ "{{baseUrl}}" ],
              "path": [ "api", "videos", "{{videoSourceId}}" ]
            }
          }
        }
      ]
    },
    {
      "name": "Analysis",
      "item": [
        {
          "name": "AI 분석 요청",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
