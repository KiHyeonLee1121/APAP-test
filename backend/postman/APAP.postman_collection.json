          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"videoSourceId\": {{videoSourceId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/analysis/jobs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "analysis",
                "jobs"
